# Copy this file to .env and fill in your actual values.
# The .env file is ignored by git, so your secrets will not be leaked.

# Set to "real" to use the Groq API, or "mock" to use built-in dummy responses.
LLM_PROVIDER=mock

# If using LLM_PROVIDER=real, provide your API key here:
GROQ_API_KEY=your_api_key_here
